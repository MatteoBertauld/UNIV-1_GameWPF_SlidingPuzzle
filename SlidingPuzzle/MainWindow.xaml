<Window x:Name="Canvas"
    x:Class="SlidingPuzzle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SlidingPuzzle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="600"
    Height="600"
    MinWidth="300"
    MinHeight="300"
    MaxWidth="1000"
    MaxHeight="1000"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>
        <Canvas DockPanel.Dock="Bottom" Height="30">
            <Canvas.Background>
                <LinearGradientBrush>
                    <GradientStop Color="#FF2B1400" />
                    <GradientStop Offset="0.5" Color="#FF7F2E00" />
                    <GradientStop Offset="1" Color="#FF2B1400" />
                </LinearGradientBrush>
            </Canvas.Background>
        </Canvas>
        <Canvas DockPanel.Dock="Top" Height="30">
            <Button x:Name="Maison"
                Width="30"
                Height="30"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="BoutonMaison_click"
                Content="">
            </Button>
            <Label x:Name="labelTemps" Content="temps" Canvas.Left="50" Foreground="White"/>
            <Canvas.Background>
                <LinearGradientBrush>
                    <GradientStop Color="#FF7F2E00" />
                    <GradientStop Offset="0.5" Color="#FF2B1400" />
                    <GradientStop Offset="1" Color="#FF7F2E00" />
                </LinearGradientBrush>
            </Canvas.Background>
        </Canvas>
        <Canvas DockPanel.Dock="Right" Width="30">
            <Canvas.Background>
                <LinearGradientBrush>
                    <GradientStop Color="#FF7F2E00" />
                    <GradientStop Offset="1" Color="#FF2B1400" />
                </LinearGradientBrush>
            </Canvas.Background>
        </Canvas>
        <Canvas DockPanel.Dock="Left" Width="30">
            <Canvas.Background>
                <LinearGradientBrush>
                    <GradientStop Color="#FF7F2E00" />
                    <GradientStop Offset="1" Color="#FF2B1400" />
                </LinearGradientBrush>
            </Canvas.Background>
        </Canvas>
        <Grid
            x:Name="maGrille"
            Background="White"
            Focusable="True"
            PreviewKeyDown="maGrille_KeyDown">
            <Label x:Name="labelMelangerGrille" Content="Appuyez sur une Touche pour mélanger la grille" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="5" Grid.RowSpan="5" Background="#CC000000" Foreground="White"/>
        </Grid>
    </DockPanel>
</Window>
