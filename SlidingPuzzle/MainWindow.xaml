<Window
    x:Class="SlidingPuzzle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SlidingPuzzle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="600"
    Height="600"
    KeyDown="CanvasKeyIsDown"
    KeyUp="CanvasKeyIsUp"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>
        <Rectangle
            Height="50"
            DockPanel.Dock="Top"
            Fill="#FF909090" />
        <Rectangle
            Width="50"
            DockPanel.Dock="Right"
            Fill="#FF909090" />
        <Rectangle
            Width="50"
            DockPanel.Dock="Left"
            Fill="#FF909090" />
        <Label
            x:Name="labelDebug"
            Canvas.Left="17"
            Canvas.Top="107"
            Height="50"
            Background="#FF909090"
            Content="Label"
            DockPanel.Dock="Bottom"
            FontSize="12" />
        <Grid x:Name="maGrille" Background="White">
            <Rectangle
                x:Name="ImagePuzzle"
                Grid.RowSpan="5"
                Grid.ColumnSpan="5"
                Canvas.Top="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" />
        </Grid>
    </DockPanel>
</Window>
