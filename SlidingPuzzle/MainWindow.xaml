<Window
    x:Class="SlidingPuzzle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SlidingPuzzle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    KeyDown="CanvasKeyIsDown"
    KeyUp="CanvasKeyIsUp"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>
        <Grid
            Height="100"
            DockPanel.Dock="Top"
            ShowGridLines="True">

            <Button
                x:Name="Generer"
                Grid.Row="1"
                Width="62"
                Height="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="Generer_Click"
                Content="Générer" />
            <Label x:Name="labTemps" Content="" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="202"/>
        </Grid>
        <Label
            x:Name="debug"
            Height="100"
            Content="Label"
            DockPanel.Dock="Bottom" />
        <Rectangle Width="100" DockPanel.Dock="Left" />
        <Rectangle Width="100" DockPanel.Dock="Right" />
        <Grid x:Name="maGrille" />
    </DockPanel>
</Window>
