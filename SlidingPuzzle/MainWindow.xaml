<Window
    x:Class="SlidingPuzzle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SlidingPuzzle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    WindowStartupLocation="CenterScreen"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Canvas
        Name="myCanvas"
        Margin="0,0,0,-6"
        Background="White"
        Focusable="True"
        KeyDown="CanvasKeyIsDown"
        KeyUp="CanvasKeyIsUp">
        <Button
            x:Name="Generer"
            Width="62"
            Height="33"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Click="Generer_Click"
            Content="Générer" Canvas.Left="10" Canvas.Top="187" />
        <Label
            x:Name="debug"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="debug :" />
        <Rectangle Height="100" Canvas.Left="125" Stroke="Black" Canvas.Top="255" Width="100"/>



    </Canvas>
</Window>
