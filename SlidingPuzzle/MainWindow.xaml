<Window
    x:Class="SlidingPuzzle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SlidingPuzzle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="600"
    Height="600"
    MinWidth="300"
    MinHeight="300"
    MaxWidth="1000"
    MaxHeight="1000"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>
        <Rectangle
            MinHeight="20"
            MaxHeight="50"
            DockPanel.Dock="Top">
            <Rectangle.Fill>
                <LinearGradientBrush>
                    <GradientStop Color="#FF7F2E00" />
                    <GradientStop Offset="0.5" Color="#FF2B1400" />
                    <GradientStop Offset="1" Color="#FF7F2E00" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle
            MinWidth="20"
            MaxWidth="50"
            DockPanel.Dock="Right">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FF7F2E00" />
                    <GradientStop Offset="1" Color="#FF2B1400" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle
            MinWidth="20"
            MaxWidth="50"
            DockPanel.Dock="Left">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FF7F2E00" />
                    <GradientStop Offset="1" Color="#FF2B1400" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Label
            x:Name="labelDebug"
            Canvas.Left="17"
            Canvas.Top="107"
            MinHeight="20"
            MaxHeight="50"
            DockPanel.Dock="Bottom"
            FontSize="12">
            <Label.Background>
                <LinearGradientBrush>
                    <GradientStop Color="#FF2B1400" />
                    <GradientStop Offset="0.5" Color="#FF7F2E00" />
                    <GradientStop Offset="1" Color="#FF2B1400" />
                </LinearGradientBrush>
            </Label.Background>
            <Button
                x:Name="buttGenerer"
                Width="105"
                Margin="370,10,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#00DDDDDD"
                Click="Button_Click_1"
                Content="Voir l'image" />
        </Label>
        <Grid x:Name="maGrille" Background="White">
            <Button
                Width="45"
                Height="45"
                Margin="-43,-49,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="Button_Click"
                Content="">
                <Button.Background>
                    <ImageBrush ImageSource="/hut.png" />
                </Button.Background>
            </Button>
        </Grid>
    </DockPanel>
</Window>
