<Window
    x:Class="SlidingPuzzle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SlidingPuzzle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="600"
    Height="600"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>
        <Rectangle
            Height="50"
            DockPanel.Dock="Top"
            Fill="#FF909090" />
        <Rectangle
            Width="50"
            DockPanel.Dock="Right"
            Fill="#FF909090" />
        <Rectangle
            Width="50"
            DockPanel.Dock="Left"
            Fill="#FF909090" />
        <Label
            x:Name="labelDebug"
            Height="50"
            Background="#FF909090"
            DockPanel.Dock="Bottom"
            FontSize="12">
            <Label
                x:Name="labTemps"
                Width="188"
                Content="" />
        </Label>
        <Grid x:Name="maGrille" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="93*"/>
                <RowDefinition Height="391*"/>
            </Grid.RowDefinitions>
            <Button x:Name="home"
                Width="44"
                Height="45"
                Margin="-43,-49,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="Button_Click"
                Content="">
                <Button.Background>
                    <ImageBrush ImageSource="/hut.png" />
                </Button.Background>
            </Button>
            <Canvas x:Name="canvaVictoire" Margin="-43,-49,-48,-48" Grid.RowSpan="2" Background="Red" Visibility="Hidden" Panel.ZIndex="1"/>
        </Grid>
    </DockPanel>
    
</Window>
