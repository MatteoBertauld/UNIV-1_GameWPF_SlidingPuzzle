<Window
    x:Class="SlidingPuzzle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SlidingPuzzle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="600"
    Height="600"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>
        <Rectangle
            Height="50"
            DockPanel.Dock="Top"
            Fill="#FF909090" />
        <Rectangle
            Width="50"
            DockPanel.Dock="Right"
            Fill="#FF909090" />
        <Rectangle
            Width="50"
            DockPanel.Dock="Left"
            Fill="#FF909090" />
        <Label
            
            x:Name="labelDebug"
            Canvas.Left="17"
            Canvas.Top="107"
            Height="50"
            Background="#FF909090"
            DockPanel.Dock="Bottom"
            FontSize="12" >
            <Button x:Name="buttGenerer" Content="Voir l'image" Margin="370,10,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#00DDDDDD" Width="105" Click="Button_Click_1"/>
        </Label>
        <Grid x:Name="maGrille" Background="White" >
            <Button Content="" HorizontalAlignment="Left" Margin="-43,-49,0,0" VerticalAlignment="Top" Height="45" Width="44" Click="Button_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/hut.png"/>
                </Button.Background>
            </Button>
        </Grid>
    </DockPanel>
</Window>
