<Window
    x:Class="SlidingPuzzle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SlidingPuzzle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="600"
    Height="600"
    MinWidth="300"
    MinHeight="300"
    MaxWidth="1000"
    MaxHeight="1000"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>
        <Rectangle Height="30" DockPanel.Dock="Top">
            <Rectangle.Fill>
                <LinearGradientBrush>
                    <GradientStop Color="#FF7F2E00" />
                    <GradientStop Offset="0.5" Color="#FF2B1400" />
                    <GradientStop Offset="1" Color="#FF7F2E00" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle Width="30" DockPanel.Dock="Right">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FF7F2E00" />
                    <GradientStop Offset="1" Color="#FF2B1400" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle Width="30" DockPanel.Dock="Left">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FF7F2E00" />
                    <GradientStop Offset="1" Color="#FF2B1400" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Label
            x:Name="labelDebug"
            Height="30"
            DockPanel.Dock="Bottom"
            FontSize="12">
            <Label.Background>
                <LinearGradientBrush>
                    <GradientStop Color="#FF2B1400" />
                    <GradientStop Offset="0.5" Color="#FF7F2E00" />
                    <GradientStop Offset="1" Color="#FF2B1400" />
                </LinearGradientBrush>
            </Label.Background>
            <Label x:Name="labTemps" Content="" Width="135"/>
        </Label>

        <Grid
            x:Name="maGrille"
            Background="White"
            Focusable="True"
            PreviewKeyDown="maGrille_KeyDown">
            <Button
                Width="30"
                Height="30"
                Margin="-30,-30,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="Button_Click"
                Content="">
                <Button.Background>
                    <ImageBrush ImageSource="/hut.png" />
                </Button.Background>
            </Button>
        </Grid>
    </DockPanel>
</Window>
