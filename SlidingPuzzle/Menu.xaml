<Window
    x:Class="SlidingPuzzle.Menu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SlidingPuzzle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Menu"
    Width="1200"
    Height="700"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>

        <ComboBox
            x:Name="comboBoxChoix"
            Width="212"
            Height="38"
            Margin="340,366,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="24">
            <ComboBoxItem Content="Facile" IsSelected="True" />
            <ComboBoxItem Content="Moyen" />
            <ComboBoxItem Content="Difficile" />
        </ComboBox>
        <Label
            x:Name="labDifficulte"
            Margin="379,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Content="Difficulté"
            FontSize="24"
            FontWeight="Bold"
            Foreground="White" />
        <Label
            x:Name="labMenu"
            Width="238"
            Height="129"
            Margin="0,33,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#0269481F"
            Content="MENU"
            FontSize="72"
            FontWeight="Bold"
            Foreground="White" />
        <Button
            x:Name="boutonJouer"
            Width="94"
            Height="49"
            Margin="0,419,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#00A06E31"
            BorderBrush="Black"
            Click="Button_Click"
            Content="JOUER"
            FontSize="22" />
        <Rectangle
            x:Name="rectDeco"
            Width="442"
            Height="174"
            Margin="0,6,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Stroke="Black" />
        <Label
            x:Name="labBasDePage
            Margin="0,627,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Content="BERTAULD Mattéo | ALLEON Victor"
            FontSize="14"
            FontWeight="Bold" />
        <Button
            x:Name="butQuitter"
            Width="51"
            Height="51"
            Margin="10,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            BorderBrush="#00707070"
            Click="quitter_Click"
            Content="">
            <Button.Background>
                <ImageBrush ImageSource="Images/close-window.png" />
            </Button.Background>
        </Button>
        <ComboBox
            x:Name="comboBoxMode"
            Width="212"
            Height="38"
            Margin="650,366,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="24">
            <ComboBoxItem Content="Une grille" IsSelected="True" />
            <ComboBoxItem Content="Deux grille" />
            <ComboBoxItem Content="Course contre-la-montre" />
        </ComboBox>
        <Label
            x:Name="labMode"
            Height="48"
            Margin="718,320,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Mode"
            FontSize="24"
            FontWeight="Bold"
            Foreground="White" />
        <Button
            x:Name="butParam"
            Width="48"
            Height="48"
            Margin="1118,608,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            BorderBrush="#00707070"
            Click="Button_Click_1"
            Content="">
            <Button.Background>
                <ImageBrush ImageSource="/settings.png" />
            </Button.Background>
        </Button>
        <Canvas x:Name="canvaParam" Visibility="Hidden">
            <Canvas.Background>
                <ImageBrush ImageSource="/fond.png" />
            </Canvas.Background>
            <Label
                Canvas.Left="436"
                Canvas.Top="55"
                Width="328"
                Height="82"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Content="PARAMETRES"
                FontSize="48"
                FontWeight="Bold"
                Foreground="White" />
            <Button
                x:Name="buttRetour"
                Canvas.Left="26"
                Canvas.Top="28"
                Width="46"
                Height="45"
                BorderBrush="#00707070"
                Click="Button_Click_2"
                Content="">
                <Button.Background>
                    <ImageBrush ImageSource="/back.png" />
                </Button.Background>
            </Button>
            <Slider x:Name="sliderSon" Canvas.Left="72" Canvas.Top="200" Width="400" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top" Minimum="0" Maximum="100"/>
            <Label x:Name="labVolume" Content="Volume :&#xD;&#xA;" Canvas.Left="72" Canvas.Top="150" Height="42" Width="126" FontSize="24" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Label x:Name="labParamTouche" Content="Gestion des touches" Canvas.Left="484" Canvas.Top="262" HorizontalAlignment="Center" VerticalAlignment="Top" Width="242" Background="Transparent" Foreground="White" FontSize="24" FontWeight="Bold"/>
            <Label Content="Finir le niveau :" Canvas.Left="72" Canvas.Top="324" FontSize="24" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Width="175"/>
            <Button x:Name="butTriche" Content="C" Canvas.Left="72" Canvas.Top="384" Height="70" Width="70" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="28" BorderBrush="#00707070" PreviewKeyDown="butTriche_PreviewKeyDown">
                <Button.Background>
                    <ImageBrush ImageSource="/toucheClavier.png"/>
                </Button.Background>
            </Button>
            <Label x:Name="labReglageSon" Content="" Canvas.Left="245" Canvas.Top="225" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center" Width="54"/>
        </Canvas>

        <Grid.Background>
            <ImageBrush ImageSource="Images/fond.png" />
        </Grid.Background>

    </Grid>
</Window>
