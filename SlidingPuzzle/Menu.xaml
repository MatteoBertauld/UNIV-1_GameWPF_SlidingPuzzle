<Window
    x:Class="SlidingPuzzle.Menu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SlidingPuzzle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Menu"
    Width="1200"
    Height="700"
    MinWidth="700"
    MinHeight="550"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid x:Name="FenetreMenuGrille" Visibility="Visible">

        <Grid x:Name="pagePrincipal">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="0.8*" />
                <RowDefinition Height="1.2*" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <ComboBox
                x:Name="comboBoxChoix"
                Grid.Row="1"
                Grid.RowSpan="2"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24">
                <ComboBoxItem Content="Facile : 3x3" IsSelected="True" />
                <ComboBoxItem Content="Moyen : 4x4" />
                <ComboBoxItem Content="Difficile : 5x5" />
            </ComboBox>

            <Label
                x:Name="labDifficulte"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Content="Difficulté"
                FontSize="24"
                FontWeight="Bold"
                Foreground="White" />

            <Label
                x:Name="labMenu"
                Grid.Row="0"
                Grid.Column="2"
                Margin="0,33,0,0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                BorderBrush="Black"
                BorderThickness="5,5,5,5"
                Content="MENU"
                FontSize="50"
                FontWeight="Bold"
                Foreground="White" />

            <Button
                x:Name="boutJouer"
                Grid.Row="1"
                Grid.RowSpan="2"
                Grid.Column="2"
                Width="150"
                Height="150"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#00000000"
                Click="BoutJouer_Click"
                FontSize="30" />

            <Label
                x:Name="labAuteur"
                Grid.Row="4"
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="BERTAULD Mattéo | ALLEON Victor"
                FontSize="14"
                FontWeight="Bold" />

            <Button
                x:Name="boutQuitter"
                Grid.Row="0"
                Grid.Column="0"
                Width="50"
                Height="50"
                Margin="15,14,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                BorderBrush="#00000000"
                Click="BoutQuitter_Click">
                <Button.Background>
                    <ImageBrush />
                </Button.Background>
            </Button>

            <Button
                x:Name="boutParam"
                Grid.Row="4"
                Grid.Column="4"
                Width="50"
                Height="50"
                Margin="0,0,15,15"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                BorderBrush="#00FF0000"
                Click="BoutParam_Click" />
            <CheckBox
                x:Name="checkBoxContreLaMontre"
                Grid.Row="1"
                Grid.Column="3"
                Padding="5,-8,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Click="CheckBoxContreLaMontre_Click"
                Content="Contre la montre"
                FontSize="20"
                IsChecked="False" />
            <Label
                x:Name="labelMinutes"
                Grid.Row="2"
                Grid.Column="4"
                Margin="28,14,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Content="min"
                Visibility="hidden" />
            <TextBox
                x:Name="textBoxTemps"
                Grid.Row="2"
                Grid.Column="4"
                Margin="8,18,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Text="{Binding ElementName=sliderTemps, Path=Value, UpdateSourceTrigger=PropertyChanged}"
                TextAlignment="Center"
                Visibility="Hidden" />
            <Slider
                x:Name="sliderTemps"
                Grid.Row="2"
                Grid.Column="3"
                Height="30"
                Margin="0,20,0,0"
                VerticalAlignment="Top"
                IsSnapToTickEnabled="True"
                Maximum="30"
                Minimum="1"
                TickPlacement="BottomRight"
                ValueChanged="sliderTemps_ValueChanged"
                Visibility="Hidden"
                Value="10" />
            <Rectangle
                x:Name="RectangleImagePuzzle"
                Grid.Row="3"
                Grid.Column="2"
                Fill="#FFBE3131"
                Stroke="Black"
                StrokeThickness="3" />
            <Button
                x:Name="boutChangerImagePuzzleGauche"
                Grid.Row="3"
                Grid.Column="1"
                Width="50"
                Height="50"
                Margin="0,0,25,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                BorderBrush="#00707070"
                Click="BoutChangerImagePuzzleGauche_Click" />
            <Button
                x:Name="boutChangerImagePuzzleDroit"
                Grid.Row="3"
                Grid.Column="3"
                Width="50"
                Height="50"
                Margin="25,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                BorderBrush="#00707070"
                Click="BoutChangerImagePuzzleDroit_Click" />
        </Grid>

        <Grid x:Name="grillePageParametre" Visibility="Hidden">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.09*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.09*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.25*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="0.25*" />
            </Grid.RowDefinitions>

            <Label
                x:Name="labParametre"
                Grid.Row="1"
                Grid.Column="2"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="PARAMETRES"
                FontSize="45"
                FontWeight="Bold"
                Foreground="White" />

            <Button
                x:Name="boutRetour"
                Grid.Row="1"
                Grid.Column="1"
                Width="50"
                Height="50"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                BorderBrush="#00707070"
                Click="BoutRetour_Clique" />

            <Slider
                x:Name="sliderSon"
                Grid.Row="2"
                Grid.Column="2"
                Grid.ColumnSpan="4"
                VerticalAlignment="Center"
                IsSnapToTickEnabled="True"
                Maximum="100"
                Minimum="0"
                TickFrequency="5"
                TickPlacement="BottomRight"
                ValueChanged="sliderSon_ValueChanged"
                Value="50" />
            <Label
                x:Name="labVolume"
                Grid.Row="2"
                Grid.Column="3"
                Grid.ColumnSpan="2"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                Content="Volume"
                FontSize="24"
                Foreground="White" />

            <Label
                x:Name="labParamTouche"
                Grid.Row="3"
                Grid.Column="2"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="Gestion des touches"
                FontSize="30"
                FontWeight="Bold"
                Foreground="White" />

            <Label
                x:Name="labTriche"
                Grid.Row="4"
                Grid.Column="2"
                Padding="0,0,0,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="Finir le niveau :"
                FontSize="24"
                Foreground="White" />

            <Button
                x:Name="boutTriche"
                Grid.Row="4"
                Grid.Column="3"
                Width="70"
                Height="70"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#00707070"
                Content="C"
                FontSize="28"
                PreviewKeyDown="BoutTriche_PreviewKeyDown" />

            <Label
                x:Name="labRecommencer"
                Grid.Row="5"
                Grid.Column="2"
                Padding="0,0,0,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="Recommencer :"
                FontSize="24"
                Foreground="White" />

            <Button
                x:Name="boutRecommencer"
                Grid.Row="5"
                Grid.Column="3"
                Width="70"
                Height="70"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#00707070"
                Content="R"
                FontSize="28"
                PreviewKeyDown="BoutRecommencer_PreviewKeyDown" />

            <Label
                x:Name="labAfficherImage"
                Grid.Row="4"
                Grid.Column="4"
                Padding="0,0,0,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="Afficher image :"
                FontSize="24"
                Foreground="White" />

            <Button
                x:Name="boutAfficherImage"
                Grid.Row="4"
                Grid.Column="5"
                Width="70"
                Height="70"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#00707070"
                Content="I"
                FontSize="28"
                PreviewKeyDown="BoutAfficherImage_PreviewKeyDown" />

            <Label
                x:Name="labPause"
                Grid.Row="5"
                Grid.Column="4"
                Padding="0,0,0,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="Pause :"
                FontSize="24"
                Foreground="White" />

            <Button
                x:Name="boutPause"
                Grid.Row="5"
                Grid.Column="5"
                Width="70"
                Height="70"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#00707070"
                Content="P"
                FontSize="28"
                PreviewKeyDown="BoutPause_PreviewKeyDown" />


        </Grid>
    </Grid>
</Window>
