<Window
    x:Class="SlidingPuzzle.Menu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SlidingPuzzle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Menu"
    Width="1200"
    Height="700"
    MinWidth="700"
    MinHeight="550"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid x:Name="FenetreMenuGrille" Visibility="Visible">

        <Grid x:Name="pagePrincipal">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="0.8*" />
                <RowDefinition Height="1.2*" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <ComboBox
            x:Name="comboBoxChoix"
            Grid.Row="1" 
            Grid.Column="1"
            Grid.RowSpan="2"
            FontSize="24" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">
                <ComboBoxItem Content="Facile : 3x3" IsSelected="True" />
                <ComboBoxItem Content="Moyen : 4x4" />
                <ComboBoxItem Content="Difficile : 5x5" />
            </ComboBox>

            <Label
            Grid.Row="1" 
            Grid.Column="1"
            x:Name="labDifficulte"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Content="Difficulté"
            FontSize="24"
            FontWeight="Bold"
            Foreground="White" Margin="0,0,0,0" />

            <Label
            x:Name="labMenu"
            Margin="0,33,0,0"
            Grid.Row="0" 
            Grid.Column="2"
            Content="MENU"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            FontSize="50"
            Foreground="White" FontWeight="Bold" BorderBrush="Black" BorderThickness="5,5,5,5" />

            <Button
            x:Name="boutJouer"
            Grid.Row="1" 
            Grid.Column="2"
            Grid.RowSpan="2"
            Width="150"
            Height="150"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderBrush="#00000000"
            Click="BoutJouer_Click"
            FontSize="30" />

            <Label
            Grid.Row="4" 
            Grid.Column="2"
            x:Name="labAuteur"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="BERTAULD Mattéo | ALLEON Victor"
            FontSize="14"
            FontWeight="Bold" />

            <Button
            x:Name="boutQuitter"
            Width="50"
            Height="50"
            Grid.Row="0" 
            Grid.Column="0"
            Margin="15,14,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="BoutQuitter_Click" BorderBrush="#00000000"
            >
                <Button.Background>
                    <ImageBrush/>
                </Button.Background>
            </Button>

            <Button 
            x:Name="boutParam"
            Width="50"
            Height="50"
            Grid.Row="4" 
            Grid.Column="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,15,15"
            BorderBrush="#00FF0000"
            Click="BoutParam_Click">
            </Button>
            <CheckBox 
            x:Name="checkBoxContreLaMontre" 
            Content="Contre la montre" 
            Grid.Row="1" 
            Grid.Column="3"
            VerticalAlignment="Bottom" 
            HorizontalAlignment="Center" 
            Click="CheckBoxContreLaMontre_Click" 
            IsChecked="False" 
            FontSize="20"
            Padding="5,-8,0,0"/>
            <Label
            Grid.Row="2" 
            Grid.Column="4"
            VerticalAlignment="Top" 
            Margin="28,14,0,0"
            x:Name="labelMinutes" 
            Content="min" 
            HorizontalAlignment="Left" 
            Visibility="Visible"/>
            <TextBox 
            x:Name="textBoxTemps" 
            Grid.Row="2" 
            Grid.Column="4"
            VerticalAlignment="Top" 
            Margin="8,18,0,0"
            Text="{Binding ElementName=sliderTemps, Path=Value, UpdateSourceTrigger=PropertyChanged}"
            TextAlignment="Center" 
            HorizontalAlignment="Left" 
            Visibility="Visible"/>
            <Slider 
            x:Name="sliderTemps"
            Grid.Row="2" 
            Grid.Column="3"
            VerticalAlignment="Top" 
            Margin="0,20,0,0"
            Height="30" 
            Visibility="Visible" 
            ValueChanged="sliderTemps_ValueChanged"
            Maximum="30" 
            TickPlacement="BottomRight" 
            IsSnapToTickEnabled="True" 
            Minimum="1" 
            Value="10"/>
            <Rectangle
            Grid.Row="3" 
            Grid.Column="2"
            x:Name="RectangleImagePuzzle"
            Fill="#FFBE3131"
            Stroke="Black" 
            StrokeThickness="3"/>
            <Button 
                Grid.Row="3" 
                Grid.Column="1"
                x:Name="boutChangerImagePuzzleGauche" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Center"
                Margin="0,0,25,0"
                Click="BoutChangerImagePuzzleGauche_Click" 
                Width="50" 
                Height="50" BorderBrush="#00707070"/>
            <Button 
                Grid.Row="3" 
                Grid.Column="3"
                x:Name="boutChangerImagePuzzleDroit" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Center" 
                 Margin="25,0,0,0"
                Click="BoutChangerImagePuzzleDroit_Click" 
                Width="50" 
                Height="50" BorderBrush="#00707070"/>
        </Grid>

        <Grid x:Name="grillePageParametre" Visibility="Hidden" Background="Gray">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.09*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.09*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.25*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="0.25*" />
            </Grid.RowDefinitions>

            <Label x:Name="labParametre"
                Grid.Row="1" 
                Grid.Column="2"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="PARAMETRES"
                FontSize="45"
                FontWeight="Bold"
                Foreground="White" />

            <Button
                Grid.Row="1" 
                Grid.Column="1"
                x:Name="boutRetour"
                Width="50"
                Height="50"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                BorderBrush="#00707070"
                Click="BoutRetour_Clique">
            </Button>

            <Slider
                x:Name="sliderSon"
                Grid.Row="2"
                Grid.Column="2"
                Grid.ColumnSpan="4"
                VerticalAlignment="Center"
                IsSnapToTickEnabled="True"
                Maximum="100"
                Minimum="0"
                TickFrequency="5"
                TickPlacement="BottomRight"
                ValueChanged="sliderSon_ValueChanged"
                Value="50" />
            <Label
                x:Name="labVolume"
                Grid.Row="2"
                Grid.Column="3"
                Grid.ColumnSpan="2"
                HorizontalContentAlignment="Center"
                x:Name="labVolume" 
                Content="Volume" 
                Height="40" 
                FontSize="24" 
                Foreground="White" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Top"/>

            <Label 
                Grid.ColumnSpan="4"
                Grid.Row="3" 
                Grid.Column="2"
                x:Name="labParamTouche" 
                Content="Gestion des touches" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center" 
                Foreground="White" 
                FontSize="30" 
                FontWeight="Bold"/>

            <Label x:Name="labTriche" 
                Padding="0,0,0,5"
                Grid.Row="4" 
                Grid.Column="2"
                Content="Finir le niveau :" 
                FontSize="24" 
                Foreground="White" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Center" />

            <Button 
                Grid.Row="4" 
                Grid.Column="3"
                x:Name="boutTriche" 
                Content="C" 
                Height="70" Width="70" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                FontSize="28" 
                BorderBrush="#00707070" 
                PreviewKeyDown="BoutTriche_PreviewKeyDown"/>

            <Label x:Name="labRecommencer" 
                Padding="0,0,0,5"
                Grid.Row="5" 
                Grid.Column="2"
                Content="Recommencer :" 
                FontSize="24" 
                Foreground="White" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Center" />

            <Button 
                Grid.Row="5" 
                Grid.Column="3"
                x:Name="boutRecommencer" 
                Content="R" 
                Height="70" Width="70" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                FontSize="28" 
                BorderBrush="#00707070" PreviewKeyDown="BoutRecommencer_PreviewKeyDown"/>

            <Label x:Name="labAfficherImage" 
                Padding="0,0,0,5"
                Grid.Row="4" 
                Grid.Column="4"
                Content="Afficher image :" 
                FontSize="24" 
                Foreground="White" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Center" />

            <Button 
                Grid.Row="4" 
                Grid.Column="5"
                x:Name="boutAfficherImage" 
                Content="I" 
                Height="70" Width="70" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                FontSize="28" 
                BorderBrush="#00707070" PreviewKeyDown="BoutAfficherImage_PreviewKeyDown"/>

            <Label x:Name="labPause" 
                Padding="0,0,0,5"
                Grid.Row="5" 
                Grid.Column="4"
                Content="Pause :" 
                FontSize="24" 
                Foreground="White" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Center" />

            <Button 
                Grid.Row="5" 
                Grid.Column="5"
                x:Name="boutPause" 
                Content="P" 
                Height="70" Width="70" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                FontSize="28" 
                BorderBrush="#00707070" PreviewKeyDown="BoutPause_PreviewKeyDown"/>


        </Grid>
    </Grid>
</Window>
